{
  "name": "@pats/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "e2e:checkin": "tsx test/e2e/checkin-matrix.ts",
    "e2e:cards": "tsx test/e2e/cards-matrix.ts",
    "db:seed:phase3": "tsx prisma/seed-phase3.ts",
    "e2e:loyalty": "tsx test/e2e/loyalty-matrix.ts",
    "e2e:social": "tsx test/e2e/social-matrix.ts",
    "db:seed:phase4": "tsx prisma/seed-phase4.ts"
  },
  "dependencies": {
    "@pats/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "aws4fetch": "1.0.20",
    "jose": "^6.2.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.16.0",
    "playwright-core": "1.64.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0",
    "exceljs": "^4.4.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
