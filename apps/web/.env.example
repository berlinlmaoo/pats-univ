# Copy to .env and fill in. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql://postgres@localhost:5432/pats_univ

# Public origin of the web app. (Card URLs always use https://patsuniv.znetworks.id, see
# CARD_URL_ORIGIN in packages/shared: they are printed and written to chips.)
APP_URL=http://localhost:3000

# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs access tokens and hashes OTP codes.
AUTH_SECRET=change-me-to-a-long-random-string

# OTP delivery: email (SMTP) | demo (code shown on screen) | whatsapp-bridge | cloud-api (not built yet)
OTP_PROVIDER=demo

# SMTP for OTP and welcome emails (OTP_PROVIDER=email). Welcome emails are skipped when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PATS University <no-reply@patsuniv.znetworks.id>"

# Seed (prisma/seed.ts): the HQ account created by `pnpm db:seed`.
SEED_SUPER_ADMIN_EMAIL=hq@patsuniv.test

# ── Cards (Phase 2) ──
# Signs card tokens and derives every NTAG password: never change it once cards are encoded.
# Dev falls back to a key derived from AUTH_SECRET; production refuses to start without it.
CARD_KEY_SECRET=
# Print template folder (relative to apps/web): card-templates/placeholder until the artwork arrives.
CARD_TEMPLATE_DIR=
# Chromium for the print PDFs. Empty = Playwright's browser cache (dev).
CHROMIUM_PATH=

# ── Files ── local (STORAGE_DIR on disk) | s3 (any S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Push ── expo (Expo Push API) | log (store notifications, send nothing)
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=
# Bearer secret for POST /api/cron/notifications (reminders and follow-ups).
CRON_SECRET=

# ── Universal / app links (/.well-known) ──
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
