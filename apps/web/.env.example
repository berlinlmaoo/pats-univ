# Copy to .env and fill in. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql://postgres@localhost:5432/pats_univ

# Public origin. Card NDEF URLs use it, so production must stay https://patsuniv.znetworks.id.
APP_URL=http://localhost:3000

# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs access tokens and hashes OTP codes.
AUTH_SECRET=change-me-to-a-long-random-string

# OTP delivery: email (SMTP) | demo (code shown on screen) | whatsapp-bridge | cloud-api (not built yet)
OTP_PROVIDER=demo

# SMTP for OTP and welcome emails (OTP_PROVIDER=email). Welcome emails are skipped when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PATS University <no-reply@patsuniv.znetworks.id>"

# Seed (prisma/seed.ts): the HQ account created by `pnpm db:seed`.
SEED_SUPER_ADMIN_EMAIL=hq@patsuniv.test

# Phase 3 cron (POST /api/cron/loyalty, Authorization: Bearer <secret>).
CRON_SECRET=
# Private receipt stub; replace with the shared storage driver when merging Phase 2.
PR_RECEIPT_STORAGE_DIR=.private-receipts
