{
  "name": "pats-univ",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @pats/web dev",
    "dev:mobile": "pnpm --filter @pats/mobile start",
    "db:migrate": "pnpm --filter @pats/web db:migrate",
    "db:seed": "pnpm --filter @pats/web db:seed",
    "db:reset": "pnpm --filter @pats/web db:reset",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
